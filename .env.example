# Copy to `.env` and fill in. Compose reads this file for both its own
# substitutions (YOUSYNC_PORT, YOUSYNC_TAG) and the values it passes to the
# container.

# YouTube Data API v3 key. Required — the server asks the API for video
# durations, and adding a video fails without it.
# https://console.cloud.google.com/apis/credentials
GOOGLE_YOUTUBE_DATA_API_V3_API_KEY=

# Host port to publish on. The container always listens on 4001.
YOUSYNC_PORT=4001

# Image tag to run. Set to a commit sha to roll back.
YOUSYNC_TAG=latest
